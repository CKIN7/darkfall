# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=darkfall
DB_PASSWORD=darkfall_password
DB_NAME=darkfall

# Logging
LOG_LEVEL=debug

# Security
API_KEY=dev-api-key-change-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs